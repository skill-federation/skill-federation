{
  "name": "skillfed",
  "version": "0.2.3",
  "description": "Find vetted agent skills for your task — no-clone installer for Skill Federation that drops the finder skill + /skillfed command into Claude Code (~/.claude). Run via `npx skillfed`. Zero runtime deps.",
  "type": "module",
  "bin": {
    "skillfed": "cli.mjs"
  },
  "files": [
    "cli.mjs",
    "install-skill.mjs",
    "payload/SKILL.md",
    "payload/demand-sketch.md",
    "payload/plan_nudge.json",
    "payload/plan_start_nudge.json",
    "payload/start_nudge.sh",
    "payload/skillfed.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "prepack": "node ../scripts/vendor-payload.mjs"
  },
  "keywords": [
    "skill-federation",
    "skillfed",
    "agent-skills",
    "skill-discovery",
    "skill-search",
    "skill-marketplace",
    "claude-code",
    "claude",
    "mcp",
    "ai-agents",
    "coding-agent",
    "cli"
  ],
  "license": "MIT",
  "homepage": "https://skillfed.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/skill-federation/skill-federation.git",
    "directory": "installer"
  },
  "bugs": {
    "url": "https://github.com/skill-federation/skill-federation/issues"
  }
}
